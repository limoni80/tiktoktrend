# Port the API listens on (Railway/Render/Fly set this automatically).
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Comma separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=https://tiktoktrend.limoniastrum.workers.dev,http://localhost:5173

# Optional: path to a Chromium binary. Leave unset to use Playwright's own.
# CHROME_PATH=/usr/bin/chromium

# Hard ceiling for one scrape request, in milliseconds.
REQUEST_TIMEOUT_MS=120000
# How long an idle TikTok browser session stays warm for pagination.
SESSION_IDLE_MS=240000
# Largest page size a client may request.
MAX_BATCH=120

# OPTIONAL escape hatch when the host IP is rate limited by TikTok.
# Supply a cookie header string. NEVER commit a real value.
# TIKTOK_COOKIE=
