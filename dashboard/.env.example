# Public URL of the Node scraping backend (no trailing slash).
# Production builds MUST set this or the app cannot load real data.
VITE_API_BASE_URL=https://your-backend.example.com

# Local development can leave it empty to use the dev server on the same origin:
# VITE_API_BASE_URL=

# Opt-in demo data. Never enable this for production.
VITE_USE_DEMO_DATA=false
