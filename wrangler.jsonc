{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktoktrend",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker owns /api/* so those requests never fall through to the SPA
  // handler (which would return index.html and break JSON parsing).
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm install --no-audit --no-fund && npm --prefix dashboard ci && npm --prefix dashboard run build"
  },
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Cloudflare Browser Rendering: a real headless Chromium inside the Worker,
  // which is what lets keyword search run without any external backend.
  // Remove this block if the account has Browser Rendering disabled.
  "browser": {
    "binding": "MYBROWSER"
  },
  "vars": {
    // Set this to the public URL of the Node/Playwright backend to enable
    // keyword search and Top Ads. Country trends work without it.
    "BACKEND_URL": ""
  }
}
