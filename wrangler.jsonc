{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktoktrend",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker owns /api/* so those requests never fall through to the SPA
  // handler (which would return index.html and break JSON parsing).
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm install --no-audit --no-fund && npm --prefix dashboard ci && npm --prefix dashboard run build"
  },
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Cloudflare Browser Rendering: a real headless Chromium inside the Worker,
  // which is what lets keyword search run without any external backend.
  // Remove this block if the account has Browser Rendering disabled.
  "browser": {
    "binding": "MYBROWSER"
  },
  // R2 stores a stable MP4 copy of each collected video, uploaded by the
  // GitHub Actions collector (OIDC-authenticated /api/media-upload). This is
  // what makes downloads permanent instead of dying with TikTok's short-lived
  // signed URLs. Create the bucket once:
  //   npx wrangler r2 bucket create tiktoktrend-media
  // Free tier: 10 GB storage, zero egress fees. Without this binding the
  // Worker answers 503 media_storage_unavailable and the dashboard falls back
  // to proxied CDN downloads (which expire within hours).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tiktoktrend-media" }
  ],
  "vars": {
    // Set this to the public URL of the Node/Playwright backend to enable
    // keyword search and Top Ads. Country trends work without it.
    "BACKEND_URL": "",
    // Datasets collected by GitHub Actions (.github/workflows/refresh-data.yml)
    // and published on the `data` branch. Serving these needs no browser at
    // all, which is what makes repeated searches unlimited. Set to "" to
    // disable and always use the live browser.
    "DATA_BASE_URL": "https://raw.githubusercontent.com/limoni80/tiktoktrend/data",
    "DATA_BRANCH": "data",
    // On-demand collection: when a searched keyword has no dataset yet, the
    // Worker asks GitHub Actions to collect it (a runner has a real Chromium
    // and an IP TikTok answers; public-repo minutes are free).
    // The token is a SECRET, never a var:
    //   npx wrangler secret put GITHUB_TOKEN
    // Fine-grained PAT, this repo only, permission "Actions: read and write".
    "GITHUB_REPO": "limoni80/tiktoktrend",
    "GITHUB_WORKFLOW_FILE": "refresh-data.yml",
    "GITHUB_REF": "main"
  }
}
